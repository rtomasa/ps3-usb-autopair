# Genuine DualShock 3 and Sixaxis controllers share Sony USB ID 054c:0268.
# Delegate pairing to systemd: udev RUN helpers must not perform long-running work.
ACTION=="add", SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0268", TAG+="systemd", ENV{SYSTEMD_WANTS}+="ps3-usb-autopair@%k.service"
